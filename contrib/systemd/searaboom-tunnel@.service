[Unit]
Description=SearaBoom Cloudflare tunnel (%i)
After=network-online.target searaboom-server@%i.service
Wants=searaboom-server@%i.service
# Do not Wants= the Mini live unit searaboom-tunnel.service.

[Service]
Type=simple
Environment=SEARABOOM_INSTANCE=%i
EnvironmentFile=-%h/.config/searaboom/%i.env
Restart=always
RestartSec=2
ExecStart=/bin/bash -c 'set -euo pipefail; ROOT="${SEARABOOM_ROOT:?set SEARABOOM_ROOT in ~/.config/searaboom/%i.env}"; exec "$ROOT/scripts/searaboom-host" tunnel --instance %i'

[Install]
WantedBy=default.target
