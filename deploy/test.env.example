# Test instance on the SAME machine as prod. Copy to ~/.config/searaboom/test.env (mode 600).
# Must use another port and a hostname that is NOT searaboom.goossen.dev.

SEARABOOM_INSTANCE=test
# Worktree of a PR branch — not the live clone that systemd prod is serving.
SEARABOOM_ROOT=/home/YOU/Work/SearaBoom-wt-some-pr

SEARABOOM_HOST=127.0.0.1
SEARABOOM_PORT=18081
SEARABOOM_PUBLIC_URL=https://searaboom-test.example.com

SEARABOOM_ADMIN_TOKEN=

# Do not attach Origin QA to the test hostname (that would steal /hw-test from Mini prod).
SEARABOOM_REQUIRE_ORIGIN=0

# Separate named tunnel + credentials. Never copy Work/SearaBoom/tunnel/*.json.
SEARABOOM_TUNNEL_CONFIG=/home/YOU/.config/searaboom/tunnel/test.yml
SEARABOOM_TUNNEL_NAME=searaboom-test
