# Prod instance. Copy to ~/.config/searaboom/prod.env (mode 600).
# Names only in git. Fill values on the host. Never commit this file with secrets.

SEARABOOM_INSTANCE=prod
# Git checkout of main that this process should serve (firmware + logs live here).
SEARABOOM_ROOT=/home/YOU/Work/SearaBoom

SEARABOOM_HOST=0.0.0.0
SEARABOOM_PORT=18080
# Field firmware is baked to this hostname. Do not change until a planned DNS cut.
SEARABOOM_PUBLIC_URL=https://searaboom.goossen.dev

# Required. Do not reuse the development default from server/app.py.
SEARABOOM_ADMIN_TOKEN=

# Optional salt for public ouvintes ids (code has a default if unset).
# SEARABOOM_OUVINTES_SALT=

SEARABOOM_SERIAL_PORT=/dev/ttyACM0
# Needed for POST /api/factory/flash on this machine. Flask itself can start without it.
# SEARABOOM_ESPTOOL_PYTHON=/home/YOU/.espressif/python_env/idf5.3_py3.14_env/bin/python
# SEARABOOM_REQUIRE_ESPTOOL=1

SEARABOOM_TUNNEL_CONFIG=/home/YOU/.config/searaboom/tunnel/prod.yml
SEARABOOM_TUNNEL_NAME=searaboom

# Origin App (QA webhooks). Mini also uses ~/.config/searaboom/origin-app/env.
SEARABOOM_REQUIRE_ORIGIN=1
ORIGIN_APP_ID=
ORIGIN_INSTALLATION_ID=
ORIGIN_APP_PRIVATE_KEY=/home/YOU/.config/searaboom/origin-app/private.pem
ORIGIN_OWNER=goossen
ORIGIN_REPO=searaboom
